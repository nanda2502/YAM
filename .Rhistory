# Load and preprocess image
img <- load.image("C:/Users/Nanda/Downloads/iskcon_logo.jpg")
img_resized <- imresize(img, scale = 0.25)
img_gray <- grayscale(img_resized)
# Improve edge detection
img_blur <- isoblur(img_gray, sigma=1)
edges <- imgradient(img_blur, "xy")
edge_magnitude <- sqrt(edges$x^2 + edges$y^2)
threshold <- quantile(as.array(edge_magnitude), 0.9)  # Adjust this threshold
binary_img <- edge_magnitude > threshold
# Extract coordinates with better sampling
coords <- which(as.array(binary_img), arr.ind = TRUE)
# Use distance-based sampling to get more evenly distributed points
dist_matrix <- as.matrix(dist(coords))
min_distance <- 5  # Adjust this value to control point density
sampled_indices <- c(1)
for(i in 2:nrow(coords)) {
if(min(dist_matrix[i, sampled_indices]) > min_distance) {
sampled_indices <- c(sampled_indices, i)
}
}
sampled_coords <- coords[sampled_indices, ]
# Convert to normalized coordinates
coords_df <- as_tibble(sampled_coords) %>%
transmute(
x = rescale(dim1, to = c(-1, 1)),
y = rescale(dim2, to = c(-1, 1))
)
# Create graph with adaptive k-nearest neighbors
# Use more neighbors for denser regions
point_density <- density(coords_df$x, coords_df$y)
k_values <- pmax(3, round(predict(point_density, coords_df) * 20))
k <- min(max(k_values), 5)  # Cap maximum connections
# Use distance-based sampling to get more evenly distributed points
dist_matrix <- as.matrix(dist(coords))
min_distance <- 5  # Adjust this value to control point density
sampled_indices <- c(1)
for(i in 2:nrow(coords)) {
if(min(dist_matrix[i, sampled_indices]) > min_distance) {
sampled_indices <- c(sampled_indices, i)
}
}
sampled_coords <- coords[sampled_indices, ]
# Convert to normalized coordinates
coords_df <- as_tibble(sampled_coords) %>%
transmute(
x = rescale(dim1, to = c(-1, 1)),
y = rescale(dim2, to = c(-1, 1))
)
# Calculate 2D density estimation
kde <- try({
kde2d(coords_df$x, coords_df$y, n = 50)
}, silent = TRUE)
# Set k based on number of points instead of density
k <- 4  # You can adjust this value
# Create k-nearest neighbors graph
nearest_neighbors <- get.knn(coords_df, k = k)
edge_list <- cbind(
rep(1:nrow(coords_df), each = k),
as.vector(nearest_neighbors$nn.index)
)
# Filter edges based on distance to reduce noise
edge_distances <- nearest_neighbors$nn.dist
max_distance <- quantile(edge_distances, 0.8)  # Adjust this threshold
valid_edges <- edge_distances < max_distance
edge_list <- edge_list[valid_edges, ]
# Create and plot graph
g <- graph_from_edgelist(edge_list, directed = FALSE)
V(g)$x <- coords_df$x
V(g)$y <- coords_df$y
# Convert to tidygraph
graph_tbl <- as_tbl_graph(g) %>%
activate(nodes) %>%
mutate(x = coords_df$x, y = coords_df$y)
# Plot with improved aesthetics
ggraph(graph_tbl, layout = 'manual', x = x, y = y) +
geom_edge_link(
color = "#5e46e2",
alpha = 0.6,
width = 0.3
) +
geom_node_point(
color = "black",
size = 0.8,
alpha = 0.7
) +
theme_void() +
coord_fixed(ratio = 1)
