s_curve <- function(x, total, offset) {
return(1 / (1 + exp(-5*((x/total) - offset))))
}
frequencies <- c(0.5, 0.3, 0.15, 0.05)
par(mfrow = c(1, 2))
plot(s_curve(frequencies[1:4], 1, 1/length(frequencies[1:4])), type = "l", main = paste("Frequencies:", paste(frequencies, collapse = " ")), sub = "Offset = 1/length(frequencies)", xlab = "x", ylab = "y", ylim = c(0, 1))
plot(s_curve(frequencies[1:4], 1, 0.5, type = "l", sub = "Offset = 0.5", xlab = "x", ylab = "y", ylim = c(0, 1)))
plot(s_curve(frequencies[1:4], 1, 0.5), type = "l", sub = "Offset = 0.5", xlab = "x", ylab = "y", ylim = c(0, 1))
par(mfrow = c(1, 2))
plot(1:4, s_curve(frequencies[1:4], 1, 1/length(frequencies[1:4])), type = "l", main = paste("Frequencies:", paste(frequencies, collapse = " ")), sub = "Offset = 1/length(frequencies)", xlab = "x", ylab = "y", ylim = c(0, 1))
plot(1:4, s_curve(frequencies[1:4], 1, 0.5), type = "l", sub = "Offset = 0.5", xlab = "x", ylab = "y", ylim = c(0, 1))
changedoffset <-  s_curve(frequencies[1:4], 1, 1/length(frequencies[1:4]))/sum(s_curve(frequencies[1:4], 1, 1/length(frequencies[1:4])))
regularoffset <- s_curve(frequencies[1:4], 1, 0.5)/sum(s_curve(frequencies[1:4], 1, 0.5))
par(mfrow = c(1, 2))
plot(1:4,changedoffset, type = "l", main = paste("Frequencies:", paste(frequencies, collapse = " ")), sub = "Offset = 1/length(frequencies)", xlab = "x", ylab = "y", ylim = c(0, 1))
plot(1:4, regularoffset, type = "l", sub = "Offset = 0.5", xlab = "x", ylab = "y", ylim = c(0, 1))
par(mfrow = c(1, 2))
plot(1:4,changedoffset, type = "l", main = paste("Frequencies:", paste(frequencies, collapse = " ")), sub = "Offset = 1/length(frequencies)", xlab = "x", ylab = "y", ylim = c(0, 1))
axis(1, at = 1:4)
par(mfrow = c(1, 2))
plot(1:4,changedoffset, type = "l", main = paste("Frequencies:", paste(frequencies, collapse = " ")), sub = "Offset = 1/length(frequencies)", xlab = "trait index", ylab = "weight", ylim = c(0, 1), xaxt = "n")
axis(1, at = 1:4)
plot(1:4, regularoffset, type = "l", sub = "Offset = 0.5", xlab = "trait index", ylab = "weight", ylim = c(0, 1), xaxt = "n")
axis(1, at = 1:4)
